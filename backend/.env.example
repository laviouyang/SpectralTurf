# Copy this file to a new file named .env and fill in your real values.
# NEVER commit .env to GitHub. It is listed in .gitignore.
#
# Get these from the Sentinel Hub dashboard:
# https://shapps.dataspace.copernicus.eu/dashboard/  ->  User settings  ->  OAuth clients  ->  Create
CDSE_CLIENT_ID=your-client-id-here
CDSE_CLIENT_SECRET=your-client-secret-here

# Optional: which website addresses may call this backend (comma-separated).
# The default below is fine for running on your own computer.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
