# Copy this file to a new file named .env and fill in your real values.
# NEVER commit .env to GitHub. It is listed in .gitignore.
#
# Get these from the Sentinel Hub dashboard:
# https://shapps.dataspace.copernicus.eu/dashboard/  ->  User settings  ->  OAuth clients  ->  Create
CDSE_CLIENT_ID=your-client-id-here
CDSE_CLIENT_SECRET=your-client-secret-here

# Optional: which website addresses may call this backend (comma-separated).
# The default below is fine for running on your own computer.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ask SpectralTurf (Google Gemini). Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-3.5-flash

# --- Only needed when deployed (Render). Set these in Render's dashboard / render.yaml,
# --- not here: .env is read after the database path is chosen.
# DATABASE_PATH=/var/data/spectralturf.db
# AI_CACHE_DIR=/var/data/ai_cache
# USAGE_LIMITS=on            (on automatically on Render; "off" turns limits off)
# TRUST_PROXY_HEADERS=1      (use the visitor's address from Render's proxy)
