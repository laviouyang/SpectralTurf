# Secrets - never upload these (second safety net; backend/.gitignore also lists .env)
.env
**/.env

# Installed packages and build output
node_modules/
dist/
venv/
.venv/
__pycache__/
*.pyc

# User accounts database
*.db

# Photo AI: the photos themselves stay on this computer (phone photos can contain
# GPS location, and the repo is public). photos.csv and the empty folders are kept.
ml/data/**/*.*
!ml/data/**/.gitkeep
ml/inbox/
ml/embeddings.npz
