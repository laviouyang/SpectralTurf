# Secrets - never upload these (second safety net; backend/.gitignore also lists .env)
.env
**/.env

# Installed packages and build output
node_modules/
dist/
venv/
.venv/
__pycache__/
*.pyc

# User accounts database
*.db

# Stage 10: raw downloads (re-creatable; never re-downloaded while present)
ml/data/cache/

# Stage 10: AI check downloads (re-creatable cache)
backend/ai_cache/

# Reference images from other websites (NOT ours to publish; never commit)
References/

# Stage 11: turf photos - never commit photos until each license is checked.
# Only the README and the metadata.csv template are tracked.
photo_data/*
!photo_data/README.md
!photo_data/metadata.csv
